generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  passwordHash String
  fullName     String
  role         String       @default("USER")
  departmentId Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  managedDepts Department[] @relation("DeptManager")
  department   Department?  @relation(fields: [departmentId], references: [id])
  roles                 UserRole[]
  dataScope             UserDataScope?
  extraPermissionsJson  String?
  deniedPermissionsJson String?

  // Additional fields
  phone                 String?
  email                 String?         @unique
  employeeCode          String?         @unique
  position              String?
  status                String          @default("ACTIVE") // ACTIVE, LOCKED, INACTIVE, RESIGNED
  mustChangePassword    Boolean         @default(false)
  passwordChangedAt     DateTime?
  failedLoginCount      Int             @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  managerUserId         Int?
  extraDepartmentIds    String?         // JSON array of integers

  managerUser           User?           @relation("UserManager", fields: [managerUserId], references: [id])
  subordinates          User[]          @relation("UserManager")
  discoveredAssets      DiscoveredAsset[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  action      String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId    Int
  roleId    Int
  validFrom DateTime?
  validTo   DateTime?
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model UserDataScope {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  scopeType         String   @default("SELF") // ALL, COMPANY, DEPARTMENT, WAREHOUSE, PROJECT, SELF, CUSTOM
  companyIdsJson    String?
  departmentIdsJson String?
  warehouseIdsJson  String?
  projectIdsJson    String?
  categoryIdsJson   String?  // Scoping limit by asset categories (JSON array of category IDs/codes)
  user              User     @relation(fields: [userId], references: [id])
}

model RoleDelegation {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  roleId     Int
  validFrom  DateTime
  validTo    DateTime
  isActive   Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now())
}

model PermissionRequest {
  id                  Int       @id @default(autoincrement())
  userId              Int
  requestedRoleId     Int?
  requestedPermission String?   // JSON array of specific overriding permission actions
  reason              String
  durationDays        Int?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model Company {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  // New fields for professional upgrade
  type         String       @default("COMPANY") // COMPANY, BRANCH, COST_CENTER, SYSTEM
  parentId     Int?
  taxCode      String?
  address      String?
  status       String       @default("ACTIVE") // ACTIVE, HIDDEN, LOCKED, ARCHIVED, MERGED
  mergedIntoId Int?
  note         String?
  createdBy    String       @default("system")

  // Relations
  parent       Company?     @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children     Company[]    @relation("CompanyHierarchy")
  departments  Department[]
}

model Department {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  managerId   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  manager     User?        @relation("DeptManager", fields: [managerId], references: [id])
  users       User[]

  // Additional fields
  type        String       @default("DEPARTMENT") // BOARD, DEPARTMENT, TEAM, PROJECT, WAREHOUSE, OTHER
  companyId   Int?
  parentId    Int?
  description String?
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE

  company     Company?     @relation(fields: [companyId], references: [id])
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
}

model Location {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectLocationNode {
  id          Int      @id @default(autoincrement())
  cityName    String
  projectName String
  parentPath  String   @default("")
  name        String
  level       Int
  status      String   @default("ACTIVE")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cityName, projectName, parentPath, name])
  @@index([cityName, projectName, status])
}

model ProjectLocationCatalog {
  id          Int      @id @default(autoincrement())
  cityName    String
  projectName String   @default("")
  status      String   @default("ACTIVE")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cityName, projectName])
  @@index([cityName, status])
}

model MasterPerson {
  id             Int      @id @default(autoincrement())
  fullName       String
  normalizedName String
  phone          String?
  position       String?
  departmentName String?
  cityName       String?
  projectName    String?
  locationName   String?
  status         String   @default("ACTIVE")
  note           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([normalizedName, status])
  @@index([departmentName])
}

model AssetCategory {
  id        Int      @id @default(autoincrement())
  code      String
  name      String
  slug      String?
  level     Int
  parentId  Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, code, level])
}

model Asset {
  id                      Int                 @id @default(autoincrement())
  assetCode               String              @unique
  assetName               String
  assetNameShort          String?
  assetNameShortSource    String?             @default("RULE")
  assetNameShortUpdatedAt DateTime?
  serialNumber            String?
  companyCode             String
  companyName             String
  projectName             String?
  level1Code              String
  level1Name              String
  level2Code              String
  level2Name              String
  level3Code              String
  level3Name              String
  level4Code              String
  level4Name              String
  runningNo               Int
  runningNoText           String
  status                  String              @default("IN_STOCK")
  unit                    String?             @default("Cái")
  purchasePriceExVat      Float?              @default(0)
  usagePurpose            String?
  supplierName            String?
  supplierTaxCode         String?
  purchaseDate            DateTime?
  currentUserName         String?
  currentUserPhone        String?
  currentPosition         String?
  currentAssigneeProfileId Int?
  departmentName          String?
  locationName            String?
  cityName                String?
  handoverDate            DateTime?
  documentNote            String?
  lastInventoryDate       DateTime?
  lastInventoryStatus     String?
  offboardingAlert        Boolean             @default(false)
  offboardingEmployeeId   String?
  offboardingEmployeeName String?
  offboardingDate         DateTime?
  expectedRecoveryDate    DateTime?
  offboardingNote         String?
  offboardingResolvedAt   DateTime?
  recoveryPriority        Int                 @default(0)
  isDeleted               Boolean             @default(false)
  isLocked                Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  lastActionAt            DateTime?
  creationBatchId         Int?
  depreciationEndDate     DateTime?
  attachments             String?
  lastLabelPrint          DateTime?
  technicalSpecsJson      String?
  creationBatch           CreationBatch?      @relation(fields: [creationBatchId], references: [id])
  invoiceBatchId          Int?
  organizationUnitId      Int?
  invoiceLineId           Int?
  originalInvoiceItemName String?
  invoiceBatch            AssetInvoiceBatch?  @relation(fields: [invoiceBatchId], references: [id])
  invoiceLine             AssetInvoiceLine?   @relation(fields: [invoiceLineId], references: [id])
  organizationUnit        OrganizationUnit?   @relation(fields: [organizationUnitId], references: [id])
  assignments             AssetAssignment[]
  editLogs                AssetEditLog[]
  events                  AssetEvent[]
  repairLogs              AssetRepairLog[]
  repairTickets           AssetRepairTicket[]
  damageReports           DamageReportItem[]
  inventoryItems          InventoryItem[]
  inventoryDetails        InventoryDetail[]
  liquidations            LiquidationItem[]
  lostReports             LostReport[]
  lostLogs                LostReportLog[]
  histories               AssetHistory[]
  normalizationSuggestions AssetNormalizationSuggestion[]
  updateProposals          AssetUpdateProposal[]
  financeProfile           AssetFinanceProfile?
  currentAssigneeProfile   AssetAssigneeProfile? @relation(fields: [currentAssigneeProfileId], references: [id], onDelete: SetNull)

  @@index([assetCode])
  @@index([serialNumber])
  @@index([locationName])
  @@index([currentUserName])
  @@index([currentAssigneeProfileId])
  @@index([offboardingAlert, expectedRecoveryDate])
  @@index([recoveryPriority])
  @@index([lastActionAt])
  @@index([organizationUnitId])
}

model AssetAssigneeProfile {
  id                   Int       @id @default(autoincrement())
  canonicalName        String
  normalizedName       String
  primaryPhone         String?
  normalizedPhone      String?
  canonicalPosition    String?
  departmentName       String?
  status               String    @default("ACTIVE") // ACTIVE, ARCHIVED
  verifiedBy           String?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  assets               Asset[]
  aliases              AssetAssigneeAlias[]
  mergeDecisions       AssetAssigneeMergeDecision[]

  @@index([normalizedName])
  @@index([normalizedPhone])
  @@index([status])
}

model AssetAssigneeAlias {
  id                   Int       @id @default(autoincrement())
  profileId            Int
  originalName         String
  normalizedName       String
  originalPhone        String?
  normalizedPhone      String?
  originalPosition     String?
  normalizedPosition   String?
  originalDepartment   String?
  normalizedDepartment String?
  source               String    @default("ASSET_REGISTER")
  createdAt            DateTime  @default(now())
  profile              AssetAssigneeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([normalizedName])
  @@index([normalizedPhone])
  @@index([profileId])
}

model AssetAssigneeMergeDecision {
  id                Int       @id @default(autoincrement())
  groupKey          String    @unique
  normalizedName    String
  status            String    @default("PENDING") // PENDING, MERGED, NOT_DUPLICATE, SKIPPED, ROLLED_BACK
  candidateSnapshot Json
  canonicalSnapshot Json?
  batchId           String?
  profileId         Int?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  profile           AssetAssigneeProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([normalizedName])
  @@index([status])
  @@index([batchId])
}

model OrganizationUnit {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  type      String
  name      String
  code      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  parent    OrganizationUnit? @relation("OrgTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgTree")
  assets    Asset[]
  tools     ToolEquipment[]
  childItems CCDCChildItem[]

  @@unique([type, code])
  @@index([parentId])
  @@index([type])
  @@index([status])
}

model AssetFinanceProfile {
  id                      Int      @id @default(autoincrement())
  assetId                 Int      @unique
  originalValue           Float    @default(0)
  purchaseDate            DateTime?
  depreciationMethod      String?
  usefulLife              Int?
  accumulatedDepreciation Float    @default(0)
  remainingValue          Float    @default(0)
  costCenter              String?
  syncedAt                DateTime?
  asset                   Asset    @relation(fields: [assetId], references: [id])

  @@index([costCenter])
}

model PurchaseRequest {
  id          Int      @id @default(autoincrement())
  requestNo   String   @unique
  requestType String   @default("ASSET")
  title       String
  description String?
  quantity    Int      @default(1)
  estimatedValue Float @default(0)
  status      String   @default("PENDING")
  requestedBy String?
  requestedAt DateTime @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  orders      PurchaseOrder[]

  @@index([status])
  @@index([requestType])
}

model PurchaseOrder {
  id                Int      @id @default(autoincrement())
  poNo              String   @unique
  requestId         Int?
  supplierName      String?
  totalValue        Float    @default(0)
  status            String   @default("DRAFT")
  createdBy         String?
  createdAt         DateTime @default(now())
  purchaseRequest   PurchaseRequest? @relation(fields: [requestId], references: [id])
  receipts          GoodsReceipt[]

  @@index([requestId])
  @@index([status])
}

model GoodsReceipt {
  id          Int      @id @default(autoincrement())
  receiptNo   String   @unique
  poId        Int?
  itemType    String   @default("ASSET")
  itemName    String
  quantity    Int      @default(1)
  unitValue   Float    @default(0)
  status      String   @default("POSTED")
  createdBy   String?
  createdAt   DateTime @default(now())
  generatedAssetId Int?
  generatedToolId  Int?
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])

  @@index([poId])
  @@index([itemType])
}

model OfflineSyncLog {
  id             Int      @id @default(autoincrement())
  deviceId       String
  userId         Int?
  action         String
  payload        String
  syncStatus     String   @default("PENDING")
  conflictPolicy String   @default("CLIENT_REVIEW")
  createdAt      DateTime @default(now())
  syncedAt       DateTime?

  @@index([deviceId])
  @@index([userId])
  @@index([syncStatus])
}

model DigitalSignature {
  id             Int      @id @default(autoincrement())
  documentId     String
  signedBy       String
  signatureImage String
  signedAt       DateTime @default(now())
  deviceInfo     String?
  lockedAt       DateTime?

  @@index([documentId])
  @@index([signedBy])
}

model AssetAnalyticsSnapshot {
  id            Int      @id @default(autoincrement())
  date          DateTime
  companyId     Int?
  assetCount    Int      @default(0)
  assetValue    Float    @default(0)
  activeCount   Int      @default(0)
  lostCount     Int      @default(0)
  repairCost    Float    @default(0)
  inventoryRate Float    @default(0)
  createdAt     DateTime @default(now())

  @@unique([date, companyId])
  @@index([date])
  @@index([companyId])
}

model IntegrationConfig {
  id        Int      @id @default(autoincrement())
  type      String
  endpoint  String
  authType  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  logs      IntegrationLog[]

  @@index([type])
  @@index([status])
}

model IntegrationLog {
  id            Int      @id @default(autoincrement())
  integrationId Int?
  direction     String   @default("OUTBOUND")
  status        String
  message       String?
  payload       String?
  createdAt     DateTime @default(now())
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([status])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  type      String
  channel   String   @default("IN_APP")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([readAt])
}

model ExportLog {
  id          Int      @id @default(autoincrement())
  exportedBy  String
  exportType  String
  rowCount    Int      @default(0)
  filtersJson String?
  createdAt   DateTime @default(now())

  @@index([exportedBy])
  @@index([exportType])
}

model CreationBatch {
  id            Int       @id @default(autoincrement())
  batchCode     String    @unique
  batchDate     DateTime  @default(now())
  companyName   String?
  supplierName  String?
  purchaseDate  DateTime?
  documentNo    String?
  totalQuantity Int       @default(0)
  totalValue    Float?    @default(0)
  status        String    @default("COMPLETED")
  note          String?
  createdAt     DateTime  @default(now())
  assets        Asset[]
}

model AssetCodeCounter {
  id          Int      @id @default(autoincrement())
  companyCode String
  level1Code  String
  level2Code  String
  level3Code  String
  level4Code  String
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([companyCode, level1Code, level2Code, level3Code, level4Code])
}

model AssetAssignment {
  id                Int      @id @default(autoincrement())
  assetId           Int
  previousUserName  String?
  newUserName       String
  newPosition       String?
  newDepartmentName String?
  newLocationName   String?
  newCityName       String?
  newStatus         String
  effectiveAt       DateTime
  note              String?
  createdAt         DateTime @default(now())
  asset             Asset    @relation(fields: [assetId], references: [id])
}

model InventoryCheck {
  id                 Int             @id @default(autoincrement())
  inventoryCode      String          @unique
  inventoryName      String
  inventoryDate      DateTime
  status             String          @default("DRAFT") // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  scopeType          String?
  scopeValue         String?
  expectedFinishDate DateTime?
  responsiblePerson  String?
  note               String?
  createdAt          DateTime        @default(now())
  items              InventoryItem[]
  sessions           InventorySession[]
  discoveredAssets   DiscoveredAsset[]
  closingRecords     InventoryClosingRecord[]
}

model InventoryItem {
  id               Int            @id @default(autoincrement())
  inventoryCheckId Int
  assetId          Int
  assetCode        String
  expectedStatus   String?
  expectedCity     String?
  expectedProject  String?
  expectedDepartment String?
  expectedUserName String?
  expectedSerialNumber String?
  actualStatus     String?
  expectedLocation String?
  actualLocation   String?
  quality          String?
  note             String?
  result              String?        // MATCHED, MISSING, EXTRA, DAMAGED, WRONG_LOCATION, NEED_REVIEW
  photos              String[]
  checkStatus         String         @default("PENDING") // PENDING, CHECKED, SCANNED, MATCH_PENDING_CONFIRM, NEED_REVIEW, ACTUAL_UPDATED, UNRESOLVED_AT_CLOSING
  checkedAt           DateTime?
  checkedBy           String?
  actualUserName      String?
  actualUserId        Int?
  actualSerialNumber  String?
  checkCondition      String?        @default("FOUND")
  physicalDetailsJson String?
  bookQuantity        Int             @default(1)
  actualQuantity      Int?
  actualCity          String?
  actualProject       String?
  actualDepartment    String?
  batchId             String?
  resultStatus        String?
  outOfBookStatus     String?        // IGNORED, REGISTERED
  lockedAt            DateTime?
  lockedBy            String?
  closingScopeId      Int?

  asset               Asset          @relation(fields: [assetId], references: [id])
  inventoryCheck      InventoryCheck @relation(fields: [inventoryCheckId], references: [id])
  closingScope        InventoryClosingScope? @relation(fields: [closingScopeId], references: [id])

  @@index([inventoryCheckId])
  @@index([assetCode])
  @@index([checkStatus])
  @@index([closingScopeId])
}

model InventorySession {
  id                 Int                     @id @default(autoincrement())
  inventoryCheckId   Int
  scheduledDate      DateTime
  companyName        String?
  projectName        String?
  departmentName     String?
  locationName       String?
  checkerName        String?
  representativeName String?
  inspectionLeaderId Int?
  inspectionLeaderName String?
  inspectionTeamName String?
  inspectionMembersJson Json?
  departmentRepresentativesJson Json?
  assetCountPlan     Int                     @default(0)
  status             String                  @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  completedAt        DateTime?
  note               String?
  createdAt          DateTime                @default(now())
  inventoryCheck     InventoryCheck          @relation(fields: [inventoryCheckId], references: [id])
  details            InventoryDetail[]
  filter             InventorySessionFilter?
  closingScopes      InventoryClosingScope[]
}

model InventorySessionFilter {
  id         Int              @id @default(autoincrement())
  sessionId  Int              @unique
  session    InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filterJson String           // JSON text representation of the selected filter criteria
  createdAt  DateTime         @default(now())
}

model InventoryDetail {
  id                 Int               @id @default(autoincrement())
  sessionId          Int
  assetId            Int?
  assetCode          String?
  assetName          String
  serialNumber       String?
  bookUserName       String?
  actualUserName     String?
  bookDepartmentName String?
  actualDepartmentName String?
  bookLocationName   String?
  actualLocationName String?
  resultStatus       String            @default("MATCH") // MATCH, WRONG_LOCATION, WRONG_USER, UNSYNCED_TRANSFER, MISSING, EXTRA, DAMAGED
  note               String?
  imageUrl           String?
  checkedAt          DateTime?
  createdAt          DateTime          @default(now())

  actualProjectName  String?
  checkStatus        String            @default("PENDING") // PENDING, CHECKED, SCANNED, MATCH_PENDING_CONFIRM, NEED_REVIEW, ACTUAL_UPDATED, UNRESOLVED_AT_CLOSING
  checkedBy          String?
  batchId            String?
  outOfBookStatus    String?           // IGNORED, REGISTERED
  lockedAt           DateTime?
  lockedBy           String?
  closingScopeId     Int?

  session            InventorySession  @relation(fields: [sessionId], references: [id])
  asset              Asset?            @relation(fields: [assetId], references: [id])
  closingScope       InventoryClosingScope? @relation(fields: [closingScopeId], references: [id])

  @@index([sessionId])
  @@index([assetCode])
  @@index([checkStatus])
  @@index([closingScopeId])
}

model InventoryClosingRecord {
  id                Int      @id @default(autoincrement())
  inventoryCheckId  Int
  closingCode       String   @unique
  closingDate       DateTime
  closedAt          DateTime?
  closedBy          String?
  status            String   @default("DRAFT") // DRAFT, PENDING_SIGN, SIGNED, FINAL, REOPENED, CANCELLED
  totalItems        Int      @default(0)
  matchedItems      Int      @default(0)
  discrepancyItems  Int      @default(0)
  missingItems      Int      @default(0)
  extraItems        Int      @default(0)
  damagedItems      Int      @default(0)
  differencePercent Float    @default(0)
  summaryJson       Json?
  closingNote       String?
  forceClose        Boolean  @default(false)
  forceCloseReason  String?
  forcedAt          DateTime?
  forcedBy          String?
  unresolvedHandlingJson Json?
  unresolvedItemsJson Json?
  version           Int      @default(1)
  reopenCount       Int      @default(0)
  reopenHistory     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventoryCheck    InventoryCheck @relation(fields: [inventoryCheckId], references: [id])
  scopes            InventoryClosingScope[]
  signers           InventoryClosingSigner[]
  reports           InventoryReportFile[]

  @@index([inventoryCheckId])
  @@index([status])
  @@index([closingDate])
}

model InventoryClosingScope {
  id              Int       @id @default(autoincrement())
  closingId       Int
  scopeType       String    // DAILY, SESSION, DEPARTMENT, PROJECT, LOCATION, FULL
  sessionId       Int?
  departmentId    Int?
  locationId      Int?
  projectValue    String?
  scopeDate       DateTime?
  scopeLabel      String?
  itemCount       Int       @default(0)
  matchedCount    Int       @default(0)
  differenceCount Int       @default(0)
  pendingCount    Int       @default(0)
  extraCount      Int       @default(0)
  missingCount    Int       @default(0)
  damagedCount    Int       @default(0)
  status          String    @default("PARTIAL") // PARTIAL, COMPLETE
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime  @default(now())

  closing         InventoryClosingRecord @relation(fields: [closingId], references: [id], onDelete: Cascade)
  session         InventorySession?      @relation(fields: [sessionId], references: [id])
  inventoryItems  InventoryItem[]
  inventoryDetails InventoryDetail[]

  @@index([closingId])
  @@index([scopeType, scopeDate])
  @@index([sessionId])
  @@index([departmentId, scopeDate])
  @@index([locationId, scopeDate])
  @@index([projectValue, scopeDate])
}

model InventoryClosingSigner {
  id             Int       @id @default(autoincrement())
  closingId      Int
